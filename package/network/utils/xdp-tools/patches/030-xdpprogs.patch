From f300abdec844b7b2c1a7f2221f0685b6633ba651 Mon Sep 17 00:00:00 2001
From: Ning Wan <quic_nwan@quicinc.com>
Date: Thu, 27 Mar 2025 10:36:50 -0400
Subject: [PATCH 1/2] add udp redirect xdp program for ipsec fastpath

Change-Id: I1e38750ce692399593d0ff6efe49dbcb049b5316
Signed-off-by: Ning Wan <quic_nwan@quicinc.com>
---
 lib/libxdp/Makefile       |  2 +-
 lib/libxdp/udp_redirect.c | 47 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 48 insertions(+), 1 deletion(-)
 create mode 100644 lib/libxdp/udp_redirect.c

diff --git a/lib/libxdp/Makefile b/lib/libxdp/Makefile
index 358b751..dea796b 100644
--- a/lib/libxdp/Makefile
+++ b/lib/libxdp/Makefile
@@ -9,7 +9,7 @@ OBJDIR ?= .
 SHARED_OBJDIR := $(OBJDIR)/sharedobjs
 STATIC_OBJDIR := $(OBJDIR)/staticobjs
 OBJS := libxdp.o xsk.o
-XDP_OBJS := xdp-dispatcher.o xsk_def_xdp_prog.o xsk_def_xdp_prog_5.3.o
+XDP_OBJS := xdp-dispatcher.o xsk_def_xdp_prog.o xsk_def_xdp_prog_5.3.o udp_redirect.o
 EMBEDDED_XDP_OBJS := $(addsuffix .embed.o,$(basename $(XDP_OBJS)))
 SHARED_OBJS := $(addprefix $(SHARED_OBJDIR)/,$(OBJS))
 STATIC_OBJS := $(addprefix $(STATIC_OBJDIR)/,$(OBJS)) $(EMBEDDED_XDP_OBJS)
diff --git a/lib/libxdp/udp_redirect.c b/lib/libxdp/udp_redirect.c
new file mode 100644
index 0000000..1d3b379
--- /dev/null
+++ b/lib/libxdp/udp_redirect.c
@@ -0,0 +1,47 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries. */
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/bpf.h>
+#include <linux/if_ether.h>
+#include <linux/ip.h>
+#include <linux/udp.h>
+#include <linux/in.h>
+#include <bpf/bpf_helpers.h>
+#include <xdp/xdp_helpers.h>
+
+#define XDP_METADATA_SECTION "xdp_metadata"
+#define XSK_PROG_VERSION 1
+
+#define IPPROTO_UDP 17
+#define MAX_ENT	64
+#define ESP_PORT 515
+
+struct {
+    __uint(type, BPF_MAP_TYPE_XSKMAP);
+    __uint(key_size, sizeof(int));
+    __uint(value_size, sizeof(int));
+    __uint(max_entries, MAX_ENT);
+} xsks_map SEC(".maps");
+
+struct {
+        __uint(priority, 20);
+	__uint(XDP_PASS, 1);
+} XDP_RUN_CONFIG(xdp_redirect_udp);
+
+SEC("xdp")
+int xdp_redirect_udp(struct xdp_md *ctx) {
+    void *data_end = (void *)(long)ctx->data_end;
+    void *data = (void *)(long)ctx->data;
+    struct iphdr *iph = data;
+
+    if (((void *)(iph + 1) < data_end) && (iph->protocol == IPPROTO_UDP))
+    {
+	    int queue_id = ctx->rx_queue_index;
+	    return bpf_redirect_map(&xsks_map, queue_id, 0);
+    }
+
+    return XDP_PASS;
+}
+
+char _license[] SEC("license") = "GPL";
+__uint(xsk_prog_version, XSK_PROG_VERSION) SEC(XDP_METADATA_SECTION);
--
2.17.1


From 8f862d257e2f35d0d2f3e4bec845f4b06e4d87d9 Mon Sep 17 00:00:00 2001
From: Srija Rangineni <srijar@qti.qualcomm.com>
Date: Tue, 13 May 2025 16:17:35 +0530
Subject: [PATCH 2/2] add udp redirect xdp program for non ipsec traffic

Signed-off-by: Srija Rangineni <srijar@qti.qualcomm.com>
---
 lib/libxdp/Makefile                           |  2 +-
 ...{udp_redirect.c => ipsecfp_udp_redirect.c} |  0
 lib/libxdp/udp_redirect.c            | 53 +++++++++++++++++++
 3 files changed, 54 insertions(+), 1 deletion(-)
 rename lib/libxdp/{udp_redirect.c => ipsecfp_udp_redirect.c} (100%)
 create mode 100644 lib/libxdp/udp_redirect.c

diff --git a/lib/libxdp/Makefile b/lib/libxdp/Makefile
index dea796b..7a179fb 100644
--- a/lib/libxdp/Makefile
+++ b/lib/libxdp/Makefile
@@ -9,7 +9,7 @@ OBJDIR ?= .
 SHARED_OBJDIR := $(OBJDIR)/sharedobjs
 STATIC_OBJDIR := $(OBJDIR)/staticobjs
 OBJS := libxdp.o xsk.o
-XDP_OBJS := xdp-dispatcher.o xsk_def_xdp_prog.o xsk_def_xdp_prog_5.3.o udp_redirect.o
+XDP_OBJS := xdp-dispatcher.o xsk_def_xdp_prog.o xsk_def_xdp_prog_5.3.o ipsecfp_udp_redirect.o udp_redirect.o
 EMBEDDED_XDP_OBJS := $(addsuffix .embed.o,$(basename $(XDP_OBJS)))
 SHARED_OBJS := $(addprefix $(SHARED_OBJDIR)/,$(OBJS))
 STATIC_OBJS := $(addprefix $(STATIC_OBJDIR)/,$(OBJS)) $(EMBEDDED_XDP_OBJS)
diff --git a/lib/libxdp/udp_redirect.c b/lib/libxdp/ipsecfp_udp_redirect.c
similarity index 100%
rename from lib/libxdp/udp_redirect.c
rename to lib/libxdp/ipsecfp_udp_redirect.c
diff --git a/lib/libxdp/udp_redirect.c b/lib/libxdp/udp_redirect.c
new file mode 100644
index 0000000..6597a4b
--- /dev/null
+++ b/lib/libxdp/udp_redirect.c
@@ -0,0 +1,53 @@
+/* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries. */
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/bpf.h>
+#include <linux/if_ether.h>
+#include <linux/ip.h>
+#include <linux/udp.h>
+#include <linux/in.h>
+#include <bpf/bpf_helpers.h>
+#include <xdp/xdp_helpers.h>
+#include <bpf/bpf_endian.h>
+
+#define XDP_METADATA_SECTION "xdp_metadata"
+#define XSK_PROG_VERSION 1
+
+#define MAX_ENT	64
+
+struct {
+    __uint(type, BPF_MAP_TYPE_XSKMAP);
+    __uint(key_size, sizeof(int));
+    __uint(value_size, sizeof(int));
+    __uint(max_entries, MAX_ENT);
+} xsks_map SEC(".maps");
+
+struct {
+        __uint(priority, 20);
+	__uint(XDP_PASS, 1);
+} XDP_RUN_CONFIG(xdp_udp_redirect);
+
+SEC("xdp")
+int xdp_udp_redirect(struct xdp_md *ctx) {
+    void *data_end = (void *)(long)ctx->data_end;
+    void *data = (void *)(long)ctx->data;
+    struct ethhdr *eth = data;
+    struct udphdr *udp = NULL;
+    struct iphdr *iph = NULL;
+
+    if (eth + 1 < data_end) {
+        if (eth->h_proto == bpf_htons(ETH_P_IP)) {
+            iph = (void *)(eth + 1);
+            if (iph + 1 < data_end && iph->protocol == IPPROTO_UDP) {
+                udp = (void *)(iph + 1);
+             }
+        }
+    }
+    if (udp == NULL){
+        return XDP_PASS;
+    }
+    return bpf_redirect_map(&xsks_map, ctx->rx_queue_index, XDP_PASS);
+}
+
+char _license[] SEC("license") = "GPL";
+__uint(xsk_prog_version, XSK_PROG_VERSION) SEC(XDP_METADATA_SECTION);
--
2.17.1

